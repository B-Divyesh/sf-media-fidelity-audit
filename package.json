{
  "name": "media-fidelity-audit-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:site",
    "build:site": "vite build",
    "test": "cargo test && node --test site/tests/license.test.mjs",
    "test:browser": "node --test site/tests/accessibility.test.mjs",
    "test:site": "node --test site/tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "vite": "6.1.0"
  }
}
